{
  "id": "ftrpg",
  "title": "Far Trek RPG",
  "description": "A lightweight system for Far Trek. Built for Foundry V14.",
  "version": "5.0.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14.367"
  },
  "authors": [
    { "name": "Some Old Pirate", "flags": {} }
  ],
  "manifest": "https://github.com/SomeOldPirate/Far-Trek/releases/latest/download/system.json",
  "download": "https://github.com/SomeOldPirate/Far-Trek/releases/latest/download/ftrpg.zip",

  "esmodules": ["module/ftrpg.mjs"],
  "styles": ["styles/ftrpg.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" }
  ],

  "documentTypes": {
    "Actor": {
      "character": {},
      "npc": {},
      "ship": {}
    },
    "Item": {
      "item": {},
      "skill": {},
      "weapon": {},
      "talent": {},
      "equipment": {}
    }
  },

  "grid": {
    "distance": 5,
    "units": "ft",
    "type": 1
  },

  "packs": [
    {
      "name": "skills",
      "label": "Skills",
      "system": "ftrpg",
      "path": "packs/skills",
      "type": "Item"
    },
    {
      "name": "talents",
      "label": "Talents",
      "system": "ftrpg",
      "path": "packs/talents",
      "type": "Item"
    },
    {
      "name": "weapons",
      "label": "Weapons",
      "system": "ftrpg",
      "path": "packs/weapons",
      "type": "Item"
    },
    {
      "name": "equipment",
      "label": "Equipment",
      "system": "ftrpg",
      "path": "packs/equipment",
      "type": "Item"
    }
  ],

  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  }
}

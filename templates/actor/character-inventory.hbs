<div class="tab {{tab.cssClass}}" data-tab="inventory" data-group="primary" data-application-part="inventory">

    <div class="item-section">
        <div class="item-header">WEAPONS</div>
        <ol class="item-list">
            {{#each weapons as |w|}}
            <li class="item flexrow" data-item-id="{{w.item.id}}">
                <div class="item-image item-image-lg"><img src="{{w.item.img}}" title="{{w.item.name}}" width="40" height="40"/></div>

                <h4 class="item-name item-roll" data-action="itemRoll" style="flex:2; cursor:pointer;">{{w.item.name}}</h4>

                {{#if w.showStunToggle}}
                <button type="button" class="phaser-mode {{w.phaserMode}}" data-action="togglePhaserMode">{{w.phaserMode}}</button>
                {{/if}}
                <div class="item-controls">
                    <a class="item-control" data-action="itemEdit" title="Edit Item"><i class="fas fa-edit"></i></a>
                    <a class="item-control" data-action="itemDelete" title="Delete Item"><i class="fas fa-trash"></i></a>
                </div>
            </li>
            {{/each}}
        </ol>
    </div>

    <div class="item-section">
        <div class="item-header">SKILLS</div>
        <ol class="item-list">
            {{#each skills as |item|}}
            <li class="item flexrow" data-item-id="{{item.id}}">
                <div class="item-image item-image-lg"><img src="{{item.img}}" title="{{item.name}}" width="40" height="40"/></div>
                <h4 class="item-name item-roll" data-action="itemRoll" style="flex:2; cursor:pointer;">{{item.name}} (Rank {{item.system.rank}})</h4>
                <div class="item-controls">
                    <a class="item-control" data-action="itemEdit" title="Edit Item"><i class="fas fa-edit"></i></a>
                    <a class="item-control" data-action="itemDelete" title="Delete Item"><i class="fas fa-trash"></i></a>
                </div>
            </li>
            {{/each}}
        </ol>
    </div>

    <div class="item-section">
        <div class="item-header">TALENTS</div>
        <ol class="item-list">
            {{#each talents as |item|}}
            <li class="item flexrow talent-item" data-item-id="{{item.id}}">
                <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                <div class="talent-body">
                    <h4 class="item-name item-roll" data-action="itemRoll" style="cursor:pointer;" title="Click to post description to chat">{{item.name}}</h4>
                    {{#if item.system.notes}}
                    <div class="talent-desc">{{item.system.notes}}</div>
                    {{/if}}
                </div>
                <div class="item-controls">
                    <a class="item-control" data-action="itemEdit" title="Edit Item"><i class="fas fa-edit"></i></a>
                    <a class="item-control" data-action="itemDelete" title="Delete Item"><i class="fas fa-trash"></i></a>
                </div>
            </li>
            {{/each}}
        </ol>
    </div>

    <div class="item-section">
        <div class="item-header">EQUIPMENT</div>
        <ol class="item-list">
            {{#each equipment as |item|}}
            <li class="item flexrow" data-item-id="{{item.id}}">
                <div class="item-image item-image-lg"><img src="{{item.img}}" title="{{item.name}}" width="40" height="40"/></div>
                <h4 class="item-name" style="flex:2;">{{item.name}}</h4>
                <div class="item-controls">
                    <a class="item-control" data-action="itemEdit" title="Edit Item"><i class="fas fa-edit"></i></a>
                    <a class="item-control" data-action="itemDelete" title="Delete Item"><i class="fas fa-trash"></i></a>
                </div>
            </li>
            {{/each}}
        </ol>
    </div>

</div>

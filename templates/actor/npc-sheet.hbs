<header class="npc-header">
    <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}"/>
    <div class="header-details">
        <input class="npc-name" name="name" type="text" value="{{actor.name}}" placeholder="NPC Name"/>
        <input class="npc-rank" type="text" name="system.details.class" value="{{system.details.class}}" placeholder="Rank / Type"/>
    </div>
</header>

<div class="sheet-body">

    <div class="wounds-container">
        <label>WOUNDS</label>
        <div class="wounds-flex">
            <input type="number" name="system.wounds.value" value="{{system.wounds.value}}"/>
            <a class="save-btn" data-action="rollSurvival" title="Consciousness Save"><i class="fas fa-heartbeat"></i></a>
        </div>
    </div>

    <div class="resources-row">
        <div class="resource-panel fate-panel">
            <div class="resource-header">Fate Points</div>
            <div class="fate-controls">
                <button type="button" data-action="fateSpend" title="Spend a Fate Point">&minus;</button>
                <input type="number" name="system.fate.value" value="{{system.fate.value}}" class="fate-value"/>
                <button type="button" data-action="fateRefresh" title="Refresh Fate to its starting value">&#8635;</button>
            </div>
        </div>
        <div class="resource-panel armor-panel">
            <div class="resource-header">Armor Bonus</div>
            <input type="number" name="system.armor.value" value="{{system.armor.value}}" class="armor-value"/>
        </div>
    </div>

    <div class="npc-attributes">
        {{#each attributes as |attr key|}}
        <div class="npc-attr-box">
            <label class="rollable" data-action="rollAttribute" data-label="{{key}}" data-key="{{key}}">{{key}}</label>
            <input type="number" name="system.attributes.{{key}}.value" value="{{attr.value}}"/>
        </div>
        {{/each}}
    </div>

    <button type="button" class="roll-init npc-init-btn" data-action="rollInit">ROLL INITIATIVE</button>

    <div class="npc-section">
        <h3>WEAPONS</h3>
        <div class="npc-list">
            {{#each weapons as |w|}}
            <div class="npc-item weapon" data-item-id="{{w.item.id}}">
                <div class="npc-item-name">
                    <span class="name">{{w.item.name}}</span>
                    <span class="stats">{{w.item.system.damage}} | TN {{w.item.system.weaponTN}}</span>
                </div>
                <div class="npc-item-controls">
                    {{#if w.showStunToggle}}
                    <button type="button" class="phaser-mode {{w.phaserMode}}" data-action="togglePhaserMode">{{w.phaserMode}}</button>
                    {{/if}}
                    <a data-action="itemRoll" title="Attack"><i class="fas fa-crosshairs"></i></a>
                    <a data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
                    <a data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <div class="npc-section">
        <h3>GEAR &amp; ABILITIES</h3>
        <div class="npc-list">
            {{#each skills as |item|}}
            <div class="npc-item skill" data-item-id="{{item.id}}">
                <span class="name">{{item.name}} ({{item.system.rank}})</span>
                <div class="npc-item-controls">
                    <a data-action="itemRoll" title="Roll"><i class="fas fa-dice"></i></a>
                    <a data-action="itemEdit" title="Edit"><i class="fas fa-edit"></i></a>
                    <a data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
            </div>
            {{/each}}
            {{#each talents as |item|}}
            <div class="npc-item talent" data-item-id="{{item.id}}">
                <span class="name">{{item.name}}</span>
                <div class="npc-item-controls">
                    <a data-action="itemEdit" title="Info"><i class="fas fa-info-circle"></i></a>
                    <a data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <div class="npc-footer">
        <a data-action="itemCreate" data-type="weapon"><i class="fas fa-plus"></i> Add Weapon/Skill</a>
    </div>

</div>
